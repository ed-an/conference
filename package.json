{
  "name": "react-conference",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/models.test.ts tests/data.test.ts tests/tokens.test.ts tests/shell.test.ts tests/routing.test.ts tests/home.test.ts && npm run test:api && npm run test:ui",
    "test:api": "vitest run api-tests/config.test.ts api-tests/registrations.http.test.ts",
    "test:integration": "vitest run api-tests/registrations.postgres.test.ts",
    "test:ui": "vitest run ui-tests --environment jsdom",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "dev:api": "node --env-file-if-exists=.env --experimental-strip-types api/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "^6.19.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^30.1.3",
    "prisma": "^6.19.0",
    "supertest": "^7.3.1",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "^5.1.0"
  }
}
